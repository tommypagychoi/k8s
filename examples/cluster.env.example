# Copy this file to cluster.env on each node and edit values for your network.

# Kubernetes version. The apt repo is pinned to this minor version.
KUBERNETES_MINOR="1.36"
KUBERNETES_VERSION="1.36.1"

# Cluster identity.
CLUSTER_NAME="prod-k8s"
POD_CIDR="192.168.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# API HA endpoint. CONTROL_PLANE_VIP must be an unused IP on the same L2 network.
CONTROL_PLANE_VIP="192.168.0.200"
CONTROL_PLANE_DNS="k8s-api.local"
CONTROL_PLANE_ENDPOINT="192.168.0.200:6443"
KEEPALIVED_INTERFACE="eth0"
KEEPALIVED_AUTH_PASS="ChangeMe42"

# Control-plane nodes.
CP1_NAME="master1"
CP1_IP="192.168.0.11"
CP2_NAME="master2"
CP2_IP="192.168.0.12"
CP3_NAME="master3"
CP3_IP="192.168.0.13"

# Worker nodes.
W1_NAME="worker1"
W1_IP="192.168.0.21"
W2_NAME="worker2"
W2_IP="192.168.0.22"
W3_NAME="worker3"
W3_IP="192.168.0.23"

# Set per node before running 10-control-plane-lb.sh.
# Use MASTER for the preferred VIP owner, BACKUP for the other two control-plane nodes.
KEEPALIVED_STATE="BACKUP"
KEEPALIVED_PRIORITY="100"
